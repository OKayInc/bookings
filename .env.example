APP_NAME="Appointment Software"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=appointment
DB_USERNAME=appointment
DB_PASSWORD=
DB_TIMEZONE=+00:00

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=memcached
CONFIGURATION_CACHE_STORE=redis
CONFIGURATION_CACHE_TTL=600
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1
CACHE_PREFIX=appointment_software_
MEMCACHED_HOST=127.0.0.1
MEMCACHED_PORT=11211
MEMCACHED_USERNAME=
MEMCACHED_PASSWORD=

QUEUE_CONNECTION=sync

FILESYSTEM_DISK=local

# Public files keep their normal storage paths. When enabled, generated URLs
# use this CDN origin instead of APP_URL (for example https://images.appointment.to/storage/...).
CDN_ENABLED=false
CDN_URL=https://images.appointment.to

# Mail transport: log, smtp, or mailgun
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="appointments@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Required only when MAIL_MAILER=mailgun. Mailgun uses its HTTP API, not SMTP.
MAILGUN_DOMAIN=null
MAILGUN_SECRET=null
MAILGUN_ENDPOINT=api.mailgun.net

# Backend email-verification signed link lifetime, in minutes.
AUTH_EMAIL_VERIFICATION_EXPIRE=60

# Contracts are private documents under the configured filesystem disk.
CONTRACT_FILESYSTEM_DISK=local
CONTRACT_TEMPLATE_MAX_KB=20480
CONTRACT_SIGNED_FILE_MAX_KB=20480
CONTRACT_SIGNED_MAX_FILES=30

# Appointment logos are presentation assets and may be publicly served.
APPOINTMENT_LOGO_DISK=public

# M4 guest booking
BOOKING_PUBLIC_HOLD_TTL_MINUTES=15
BOOKING_EMAIL_VERIFICATION_TTL_HOURS=24

# Deployment fallbacks for questionnaire validation. Organization settings override them.
GOOGLE_MAPS_API_KEY=
# Optional separate server-side key for M7-R12 driving-distance pricing.
# Falls back to GOOGLE_MAPS_API_KEY when omitted. Enable Google Routes API.
GOOGLE_ROUTES_API_KEY=
GOOGLE_ROUTES_CACHE_SECONDS=900
QUESTIONNAIRE_DEFAULT_PHONE_REGION=CA
QUESTIONNAIRE_EMAIL_DNS_VALIDATION=true
QUESTIONNAIRE_FILE_DISK=local

BOOKING_SCHEDULE_PROPOSAL_DEFAULT_TTL_HOURS=24
BOOKING_SCHEDULE_PROPOSAL_MAX_TTL_HOURS=168


# Calendar integrations (M7)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_TENANT=common
MICROSOFT_CALENDAR_REDIRECT_URI=
CALENDAR_HTTP_TIMEOUT_SECONDS=8
CALENDAR_BUSY_CACHE_SECONDS=30
CALENDAR_SYNC_DAYS_BACK=2
CALENDAR_SYNC_DAYS_AHEAD=730
CALENDAR_OAUTH_STATE_TTL_MINUTES=15

# Online meeting providers (credentials are saved per organization in Settings)
CONFERENCE_HTTP_TIMEOUT_SECONDS=10
JITSI_BASE_URL=https://meet.jit.si

# Payment provider credentials are encrypted and saved per organization in Organization → Payments.
PAYMENT_REQUEST_TIMEOUT_SECONDS=20
PAYMENT_CHECKOUT_TTL_MINUTES=60
PAYMENT_BOOKING_WINDOW_MINUTES=60
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300

# Organization logo storage disk (run php artisan storage:link when using public)
ORGANIZATION_LOGO_DISK=public
ORGANIZATION_MEMBER_INVITATION_TTL_DAYS=7

# M11 product plans. PLATFORM_OWNER_USER_ID is the UUID shown for the one
# backend user allowed to grant/revoke Complimentary Unlimited in the owner UI.
# Organization UUIDs in the comma-separated allowlist receive the same access
# even if the database is unavailable; deployment configuration has precedence.
PLATFORM_OWNER_USER_ID=
PLAN_COMPLIMENTARY_UNLIMITED_ORGANIZATION_IDS=
PLAN_BUSINESS_TRIAL_DAYS=14
PLAN_BILLING_GRACE_DAYS=3
PLAN_BUSINESS_CURRENCY=usd
PLAN_BUSINESS_MONTHLY_PRICE_MINOR=900
PLAN_BUSINESS_ANNUAL_PRICE_MINOR=9000

# Free limits (per organization unless marked monthly).
PLAN_FREE_MAX_OWNED_ORGANIZATIONS=1
PLAN_FREE_MAX_MEMBERS=2
PLAN_FREE_MAX_ACTIVE_APPOINTMENT_TYPES=3
PLAN_FREE_MAX_MONTHLY_BOOKINGS=50
PLAN_FREE_MAX_RESOURCES=3
PLAN_FREE_MAX_PERSON_RESOURCES=1
PLAN_FREE_MAX_CALENDAR_CONNECTIONS=2
PLAN_FREE_MAX_STORAGE_MB=250
PLAN_FREE_MAX_DISTANCE_LOOKUPS=25
PLAN_FREE_MAX_QUESTIONS=5

# Included Business capacity. Paid add-ons extend these values.
PLAN_BUSINESS_MAX_MEMBERS=10
PLAN_BUSINESS_MAX_ACTIVE_APPOINTMENT_TYPES=25
PLAN_BUSINESS_MAX_MONTHLY_BOOKINGS=500
PLAN_BUSINESS_MAX_RESOURCES=25
PLAN_BUSINESS_MAX_PERSON_RESOURCES=10
PLAN_BUSINESS_MAX_CALENDAR_CONNECTIONS=10
PLAN_BUSINESS_MAX_STORAGE_MB=5120
PLAN_BUSINESS_MAX_DISTANCE_LOOKUPS=250

# Platform subscription Stripe account. These credentials are separate from
# the payment credentials organizations save for charging their own clients.
PLAN_STRIPE_SECRET_KEY=
PLAN_STRIPE_WEBHOOK_SECRET=
PLAN_STRIPE_API_URL=https://api.stripe.com
PLAN_STRIPE_API_VERSION=2025-06-30.basil
PLAN_STRIPE_TIMEOUT_SECONDS=20
PLAN_STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
PLAN_STRIPE_PRICE_BUSINESS_MONTHLY=
PLAN_STRIPE_PRICE_BUSINESS_ANNUAL=
# Each monthly add-on Price uses the advertised monthly amount. Each annual
# Price uses 12 times that amount and recurs yearly.
PLAN_STRIPE_PRICE_ADDON_MEMBER_MONTHLY=
PLAN_STRIPE_PRICE_ADDON_MEMBER_ANNUAL=
PLAN_STRIPE_PRICE_ADDON_APPOINTMENT_TYPE_MONTHLY=
PLAN_STRIPE_PRICE_ADDON_APPOINTMENT_TYPE_ANNUAL=
PLAN_STRIPE_PRICE_ADDON_BOOKING_BLOCK_MONTHLY=
PLAN_STRIPE_PRICE_ADDON_BOOKING_BLOCK_ANNUAL=
PLAN_STRIPE_PRICE_ADDON_RESOURCE_MONTHLY=
PLAN_STRIPE_PRICE_ADDON_RESOURCE_ANNUAL=
PLAN_STRIPE_PRICE_ADDON_CALENDAR_MONTHLY=
PLAN_STRIPE_PRICE_ADDON_CALENDAR_ANNUAL=
PLAN_STRIPE_PRICE_ADDON_STORAGE_GB_MONTHLY=
PLAN_STRIPE_PRICE_ADDON_STORAGE_GB_ANNUAL=
PLAN_STRIPE_PRICE_ADDON_DISTANCE_BLOCK_MONTHLY=
PLAN_STRIPE_PRICE_ADDON_DISTANCE_BLOCK_ANNUAL=

# Google AdSense appears only on eligible public Free-plan listing and public
# appointment pages. It is never loaded on backend, private, booking or payment flows.
PLAN_ADSENSE_ENABLED=false
PLAN_ADSENSE_CLIENT=
PLAN_ADSENSE_SLOT=

# M9-R8 photo galleries. Uploaded JPEG/PNG/WebP files are resized and encoded
# as WebP on this public disk. Limits apply separately to the organization
# gallery and to every appointment-type gallery.
GALLERY_DISK=public
GALLERY_FREE_MAX_ORGANIZATION_PHOTOS=6
GALLERY_PAID_MAX_ORGANIZATION_PHOTOS=60
GALLERY_FREE_MAX_APPOINTMENT_PHOTOS=6
GALLERY_PAID_MAX_APPOINTMENT_PHOTOS=30
GALLERY_MAX_UPLOAD_KB=20480
GALLERY_MAX_BATCH_SIZE=20
GALLERY_MAX_WIDTH=2400
GALLERY_MAX_HEIGHT=2400
GALLERY_MAX_MEGAPIXELS=50
GALLERY_WEBP_QUALITY=82
